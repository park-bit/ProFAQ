# Database
DATABASE_URL=sqlite+aiosqlite:///./data/profaq.db

# Qdrant (supports Docker host/port, Qdrant Cloud URL, or local embedded mode on QDRANT_PATH)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_PATH=./data/qdrant
QDRANT_URL=
QDRANT_API_KEY=

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Reranker model
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# NLI grounding model
NLI_MODEL=cross-encoder/nli-deberta-v3-small

# LLM Provider: groq, ollama, openai, gemini, or hybrid
LLM_PROVIDER=groq

# Groq (free fast online inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (offline local inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Retrieval settings
BM25_TOP_K=20
DENSE_TOP_K=20
RERANK_TOP_K=5
SIMILARITY_THRESHOLD=0.35

# Chunking
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# HuggingFace cache: kept inside the project folder, not in C:\Users
HF_HOME=./data/hf_cache
TRANSFORMERS_CACHE=./data/hf_cache/hub
SENTENCE_TRANSFORMERS_HOME=./data/hf_cache/sentence_transformers

